# Build from source because deployed image lacks 'src'
FROM node:18-alpine

# Install git and build tools
RUN apk add --no-cache git python3 make g++

WORKDIR /app

# Clone specific version to match user expectation (v3.0.3)
RUN git clone --depth 1 --branch v3.0.3 https://github.com/umami-software/umami.git .

# Install dependencies
# Set timeout high for slow CI
RUN npm config set fetch-retry-maxtimeout 600000 && \
    npm install --include=dev --legacy-peer-deps

# Apply our Patch
COPY prisma.custom.ts /app/src/lib/prisma.ts

# Build
ARG DATABASE_TYPE=postgresql
ENV DATABASE_TYPE=$DATABASE_TYPE
ARG DATABASE_URL="postgresql://build:5432/build?sslmode=disable"
ENV DATABASE_URL=$DATABASE_URL
RUN npx prisma generate && \
    npm install prop-types --legacy-peer-deps && \
    npm run build-app && \
    cp -r public .next/standalone/public && \
    mkdir -p .next/standalone/.next && \
    cp -r .next/static .next/standalone/.next/static

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER node
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["npm", "run", "start-server"]
